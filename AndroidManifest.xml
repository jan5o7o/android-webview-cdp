<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.so7o.webview"
    android:versionCode="4"
    android:versionName="0.4">

    <!-- Not needed for CDP-over-adb-forward (that path is a local socket).
         Needed only if the page itself loads remote content. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera: getUserMedia() inside the WebView is gated twice — the app must
         hold this Android permission AND grant RESOURCE_VIDEO_CAPTURE in
         WebChromeClient.onPermissionRequest (see MainActivity). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Microphone: getUserMedia({audio}), SpeechRecognition. Granted only when a
         page asks (RESOURCE_AUDIO_CAPTURE). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Normal permission (auto-granted at install), needed for the Screen Wake
         Lock API: navigator.wakeLock.request('screen'). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Keeps the process out of the frozen cgroup while backgrounded, so the
         DevTools socket stays reachable from Termux. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="So7o Webview Shell"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="So7o Webview Shell"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keep the WebView and its DevTools debugging socket reachable while the app is backgrounded" />
        </service>

    </application>
</manifest>
